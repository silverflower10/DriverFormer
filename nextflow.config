// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch + GPU 요청)

nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 파라미터 기본값
 * --------------------------- */
params {
  pipeline_only    = false
  mutations_file   = null
  all_pred         = null

  out_dir          = 'results/run'

  // 학습 관련
  lr               = 2e-4
  batch_size       = 128
  epochs           = 20
  segment_lengths  = [10, 50, 100]
  label_roll       = true
  label_roll_width = 2
  save_attention   = false

  // (옵션) GitHub Release 분할 파츠
  use_release      = false
  gh_repo          = null
  release_tag      = null
  asset_name       = 'parts'
  asset_sha256     = null
  gh_token         = null
}
params.post_dir = "${params.out_dir}/postproc"

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 프로세스 공통 기본 리소스 + GPU 정책
 * --------------------------- */
process {
  // 기본값(경량 태스크)
  cpus   = 4
  memory = '16 GB'
  time   = '24h'

  // ★ GPU 라벨에 대해 GPU 1개 요청 (Nextflow 24.x 규칙)
  withLabel: gpu {
    accelerator 1
    cpus   = 16
    memory = '128 GB'
    time   = '72h'
  }

  // 실행 프로세스 이름에 라벨 보강(메인에서 label 'gpu' 가 없더라도 안전)
  withName: DRIVERFORMER_RUN {
    label 'gpu'
  }
  // (이전 버전 대비)
  withName: TRAIN_DRIVERFORMER {
    label 'gpu'
  }
}

/* ---------------------------
 * 프로파일 (CloudOS 최소)
 * --------------------------- */
profiles {
  awsbatch_gpu {
    process {
      executor      = 'awsbatch'
      // ⚠ queue는 보통 CloudOS UI에서 고른 GPU 큐를 쓰는 게 안전.
      // 특정 GPU 큐로 고정하려면 아래 줄 주석 해제 후 ID/이름을 GPU 큐로 바꿔 사용.
      // queue       = 'run_DriverFormer'
      container     = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = false
  }
}
