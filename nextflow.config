// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch)
nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 파라미터 기본값
 * --------------------------- */
params {
  pipeline_only    = false
  mutations_file   = null
  all_pred         = null

  out_dir          = 'results/run'
  // post_dir은 아래에서 params.out_dir을 참조해 파생값으로 설정합니다.

  // 학습 관련
  lr               = 2e-4
  batch_size       = 128
  epochs           = 20
  segment_lengths  = [10, 50, 100]
  label_roll       = true
  label_roll_width = 2
  save_attention   = false

  // (옵션) GitHub Release에서 큰 파일을 분할 다운로드할 때 사용
  use_release      = false       // true로 바꾸면 release 파츠 경로 사용
  gh_repo          = null        // 예) 'yourname/driverformer'
  release_tag      = null        // 예) 'v0.1.0'
  asset_name       = 'parts'     // 분할 파일 접두어 (parts.part-01, parts.part-02 …)
  asset_sha256     = null        // 원본 아카이브의 SHA256 (무결성 체크)
  gh_token         = null        // private repo 접근 시 GitHub 토큰
}
// 파생 파라미터 (다른 params 참조는 블록 밖에서 하는 게 안전합니다)
params.post_dir = "${params.out_dir}/postproc"

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 프로세스 공통 기본 리소스
 * --------------------------- */
process {
  cpus   = 4
  memory = '16 GB'
  time   = '24h'
}

/* ---------------------------
 * 프로파일
 *   - 반드시 이 블록 안에 프로파일들을 넣어야 합니다!
 * --------------------------- */
profiles {

  /* ===== CloudOS/AWS Batch (S3 입력, 일반 실행) ===== */
  awsbatch_s3 {
    // CloudOS에서 CE/큐/리전이 이미 지정되는 경우 이 항목은 무시/오버라이드될 수 있습니다.
    workDir          = 's3://<YOUR-S3-BUCKET>/nf-work'   // ← 바꾸세요
    aws.region       = '<ap-northeast-2 등>'             // ← 바꾸세요

    process {
      executor       = 'awsbatch'
      queue          = 'run_DriverFormer'                // ← CloudOS에서 만든 Batch 큐
      container      = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy  = 'retry'
      maxRetries     = 2
      // AWS Batch는 GPU 인스턴스라면 대체로 --gpus 옵션 불필요
    }

    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = true    // Wave 사용 시
  }

  /* ===== CloudOS/AWS Batch (GitHub Release 분할 파츠 사용) ===== */
  awsbatch_release_parts {
    workDir          = 's3://<YOUR-S3-BUCKET>/nf-work'   // ← 바꾸세요
    aws.region       = '<ap-northeast-2 등>'             // ← 바꾸세요

    process {
      executor       = 'awsbatch'
      queue          = 'run_DriverFormer'
      container      = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy  = 'retry'
      maxRetries     = 2
    }

    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = true    // Release 파츠 모드에서도 Wave 사용 가능
  }

  /* ===== CloudOS/AWS Batch (GPU CE, Wave 끈 모드 — 403 회피용) ===== */
  awsbatch_gpu {

    process {
      executor       = 'awsbatch'
      queue          = 'run_DriverFormer'                // GPU CE가 연결된 큐
      container      = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy  = 'retry'
      maxRetries     = 2
    }

    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = false   // Wave 비활성화
  }
}
