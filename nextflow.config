// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch 최소)
nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 파라미터 기본값 (main.nf와 일치)
 * --------------------------- */
params {
  pipeline_only    = false
  mutations_file   = null
  all_pred         = null

  out_dir          = 'results/run'
  // post_dir은 아래에서 params.out_dir을 참조해 파생값으로 설정합니다.

  // 학습 관련
  lr               = 2e-4
  batch_size       = 128
  epochs           = 20
  segment_lengths  = [10, 50, 100]
  label_roll       = true
  label_roll_width = 2
  save_attention   = false

  // 설치 단계 on/off (SETUP_DEPS → DRIVERFORMER_RUN)
  setup_deps       = true

  // (옵션) GitHub Release 분할 파츠 사용 시
  use_release      = false
  gh_repo          = null
  release_tag      = null
  asset_name       = 'parts'
  asset_sha256     = null
  gh_token         = null
}
params.post_dir = "${params.out_dir}/postproc"

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 프로세스 기본 리소스 + 프로세스별 오버라이드
 * --------------------------- */
process {
  // 기본값(나머지 경량 태스크용)
  cpus   = 4
  memory = '16 GB'
  time   = '24h'

  // 비대화식 pip 환경
  env {
    PIP_NO_INPUT = '1'
    PIP_DISABLE_PIP_VERSION_CHECK = '1'
  }

  // 설치 단계(venv) — 비교적 가볍게
  withName: SETUP_DEPS {
    cpus   = 2
    memory = '8 GB'
    time   = '2h'
  }

  // 실행 단계 — 학습/추론 리소스
  withName: DRIVERFORMER_RUN {
    cpus   = 8
    memory = '32 GB'
    time   = '72h'
  }
}

/* ---------------------------
 * 프로파일 (CloudOS/AWS Batch 최소)
 * --------------------------- */
profiles {
  awsbatch_gpu {
    process {
      executor       = 'awsbatch'
      queue          = 'run_DriverFormer'                // CloudOS 큐 이름
      container      = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy  = 'retry'
      maxRetries     = 2
    }
    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = false   // Wave 403 회피
  }
}
