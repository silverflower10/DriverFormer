// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch 최소)
nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 파라미터 기본값
 * --------------------------- */
params {
  pipeline_only    = false
  mutations_file   = null
  all_pred         = null

  out_dir          = 'results/run'
  // post_dir은 아래에서 params.out_dir을 참조해 파생값으로 설정합니다.

  // 학습 관련
  lr               = 2e-4
  batch_size       = 128
  epochs           = 20
  segment_lengths  = [10, 50, 100]
  label_roll       = true
  label_roll_width = 2
  save_attention   = false

  // (옵션) GitHub Release 분할 파츠 사용 시
  use_release      = false
  gh_repo          = null
  release_tag      = null
  asset_name       = 'parts'
  asset_sha256     = null
  gh_token         = null
}
// 파생 파라미터 (다른 params 참조는 블록 밖이 안전)
params.post_dir = "${params.out_dir}/postproc"

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 프로세스 공통 기본 리소스
 * --------------------------- */
process {
  cpus   = 16
  memory = '64 GB'
  time   = '24h'
}

/* ---------------------------
 * 프로파일 (CloudOS 최소)
 * --------------------------- */
profiles {
  awsbatch_gpu {
    process {
      executor      = 'awsbatch'
      container     = 'pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime'  // ← cu118
      errorStrategy = 'retry'
      maxRetries    = 2
      accelerator   = 1 
    }
    docker {
      enabled   = true
      runOptions = '--shm-size=32g'
    }
    singularity.enabled = false
    wave.enabled        = false
  }
}

