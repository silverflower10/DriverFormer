// nextflow.config — DriverFormer (DSL2, CloudOS)

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

params {
  pipeline_only   = false
  mutations_file  = null
  all_pred        = null
  out_dir         = 'results/run'
  post_dir        = "${out_dir}/postproc"

  lr              = 2e-4
  batch_size      = 128
  epochs          = 20
  segment_lengths = [10,50,100]
  label_roll      = true
  label_roll_width= 2
  save_attention  = false

  use_release     = false
  gh_repo         = null
  release_tag     = null
  asset_name      = "parts"
  asset_sha256    = null
  gh_token        = null
}

profiles {

  // 로컬/SLURM은 생략 (필요 시 추가)

  // === CloudOS/AWS Batch (S3 입력 일반 실행) ===
  awsbatch_s3 {
    process {
      executor  = 'awsbatch'
      queue     = 'run_DriverFormer'   // CloudOS에서 만든 Batch 큐 이름
      // GPU PyTorch 런타임 예시(공개 이미지) — 필요시 여러분의 ECR 이미지로 교체
      container = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled = true
    singularity.enabled = false
    wave.enabled = true

    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  // === CloudOS/AWS Batch (GitHub Release 분할 파트) ===
  awsbatch_release_parts {
    process {
      executor  = 'awsbatch'
      queue     = 'run_DriverFormer'
      container = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled = true
    singularity.enabled = false
    wave.enabled = true

    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }
}
