// nextflow.config — DriverFormer (DSL2)

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

params {
  // === pipeline 기본 ===
  pipeline_only   = false
  mutations_file  = null        // training 모드에서는 필수
  all_pred        = null        // pipeline-only 모드에서는 필수

  out_dir         = 'results/run'
  post_dir        = "${out_dir}/postproc"

  // === 학습 하이퍼파라미터(필요시 UI에서 덮어쓰기) ===
  lr              = 2e-4
  batch_size      = 128
  epochs          = 20
  segment_lengths = [10,50,100]
  label_roll      = true
  label_roll_width= 2
  save_attention  = false

  // === 릴리즈(깃허브) 입력 옵션 ===
  use_release     = false
  gh_repo         = null                  // 예: "silverflower10/DriverFormer"
  release_tag     = null                  // 예: "breast-data-v1"
  asset_name      = "parts"               // "parts" 또는 "breast_data.tar.gz"
  asset_sha256    = null
  gh_token        = null
}

/* 공통 인스트루먼테이션(로그/리포트) */
profiles {

  local {
    process.executor = 'local'
    docker.enabled   = false
    singularity.enabled = false
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  slurm {
    process.executor = 'slurm'
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  /*
   * CloudOS/AWS Batch — 일반(S3 입력) 프로파일
   * - 큐/이미지 바꾸려면 아래 queue/container만 수정
   */
  awsbatch_s3 {
    process {
      executor  = 'awsbatch'
      queue     = 'run_DriverFormer'  // CloudOS에서 만든 Batch 큐 이름
      // !! 이미지는 꼭 유효한 것으로 교체하세요(예: ECR에 올린 driverformer 이미지)
      container = 'public.ecr.aws/docker/library/python:3.11-bullseye'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled = true
    singularity.enabled = false
    wave.enabled = true
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  /*
   * CloudOS/AWS Batch — GitHub Release(분할 파트) 사용
   * - params: use_release=true, gh_repo, release_tag, asset_name=parts, (private면 gh_token)
   */
  awsbatch_release_parts {
    process {
      executor  = 'awsbatch'
      queue     = 'run_DriverFormer'
      container = 'public.ecr.aws/docker/library/python:3.11-bullseye'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled = true
    singularity.enabled = false
    wave.enabled = true
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  /*
   * CloudOS/AWS Batch — GitHub Release(tar.gz) 사용
   */
  awsbatch_release_tar {
    process {
      executor  = 'awsbatch'
      queue     = 'run_DriverFormer'
      container = 'public.ecr.aws/docker/library/python:3.11-bullseye'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled = true
    singularity.enabled = false
    wave.enabled = true
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  /*
   * (옵션) GPU 이미지 사용 예시 — 필요시 사용
   * - CUDA 런타임 포함 이미지, 혹은 여러분의 ECR 이미지로 교체
   */
  awsbatch_gpu {
    process {
      executor  = 'awsbatch'
      queue     = 'run_DriverFormer'
      container = 'xxxxxxxxxxxx.dkr.ecr.<region>.amazonaws.com/driverformer:cuda12' // 교체
      errorStrategy = 'retry'
      maxRetries    = 2
      // containerOptions = '--gpus all'   // 이미지 런타임 설정에 따라 필요할 수 있음
    }
    docker.enabled = true
    singularity.enabled = false
    wave.enabled = true
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }
}
