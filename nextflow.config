// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch robust)

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 컨테이너 참조(우선순위)
 *   --container >
 *   (repo @ digest) >
 *   (repo : tag)
 * --------------------------- */
params.container        = params.container        ?: null
params.container_repo   = params.container_repo   ?: 'docker.io/silverflower10/driverformer'
params.container_tag    = params.container_tag    ?: null
// ← 운영에서 쓰는 다이제스트(필요시 --container_digest 로 덮어쓰기)
params.container_digest = params.container_digest ?: 'sha256:ac15ea10f138b6f03552e0c59d804fac2903392623a5cfb92b6d7340564237c8'

def CONTAINER_REF = params.container ?:
                    (params.container_digest ? "${params.container_repo}@${params.container_digest}"
                                             : (params.container_tag ? "${params.container_repo}:${params.container_tag}"
                                                                     : "${params.container_repo}@${params.container_digest}"))

/* ---------------------------
 * 파라미터 기본값 (main.nf와 일치)
 * --------------------------- */
params {
  pipeline_only    = false
  mutations_file   = null
  all_pred         = null

  out_dir          = 'results/run'
}
params.post_dir = "${params.out_dir}/postproc"

// (필요시 하이퍼파라미터 등은 main.nf와 동일 키로 추가)

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 글로발 런타임(프로필 미적용 대비)
 * --------------------------- */
docker.enabled      = true
singularity.enabled = false

process {
  // 기본 리소스 (경량 태스크)
  cpus   = 4
  memory = '16 GB'
  time   = '24h'

  // 비대화식 pip
  env {
    PIP_NO_INPUT = '1'
    PIP_DISABLE_PIP_VERSION_CHECK = '1'
  }

  // 전역 컨테이너(프로필 안 먹어도 강제 적용)
  container = CONTAINER_REF

  // GPU 라벨 정책 (라벨 'gpu'에 GPU 1개 할당)
  withLabel: gpu {
    accelerator 1
    cpus   = 16
    memory = '128 GB'
    time   = '72h'
  }

  // 설치 단계(venv) — 비교적 가볍게
  withName: SETUP_DEPS {
    cpus   = 2
    memory = '8 GB'
    time   = '2h'
  }

  // 실행 단계 — 학습/추론 리소스
  withName: DRIVERFORMER_RUN {
    cpus   = 8
    memory = '32 GB'
    time   = '72h'
    label  'gpu'          // ← 이 단계에 GPU 정책 적용
  }
}

/* ---------------------------
 * 프로파일 (CloudOS/AWS Batch)
 * --------------------------- */
profiles {
  // CloudOS에서 선택 권장
  awsbatch_gpu {
    process {
      executor      = 'awsbatch'               // 실행기 강제
      // ★ 큐는 UI 선택값을 쓰는 게 안전함. 특정 큐로 고정하려면 주석 해제:
      // queue       = 'run_DriverFormer'
      container     = CONTAINER_REF            // 다이제스트/태그/직접지정 우선순위
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled      = true
    singularity.enabled = false
    wave.enabled        = false                // Wave 403 회피(환경에 따라)
  }

  // 표준으로 떠도 Batch로 가도록 세이프가드
  standard {
    process.executor    = 'awsbatch'
    docker.enabled      = true
    singularity.enabled = false
  }

  // 로컬 도커 테스트용
  docker {
    process.executor    = 'local'
    docker.enabled      = true
    singularity.enabled = false
    docker.runOptions   = System.env.NF_GPU ? "--gpus ${System.env.NF_GPU}" : ''
    process.container   = CONTAINER_REF
  }

  // 순수 로컬(호스트 파이썬) 테스트용
  local {
    process.executor    = 'local'
    docker.enabled      = false
    conda.enabled       = false
  }
}
