// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch)
nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 파라미터 기본값 (Python args 1:1 매핑)
 * --------------------------- */
params {
  // === 실행 모드 ===
  pipeline_only        = false          // true면 학습 건너뛰고 --all_pred 로 바로 파이프라인
  run_pipeline         = false          // 학습 직후 자동 파이프라인 실행

  // === 입출력 ===
  cls_file             = null           // REQUIRED(훈련) — pickled cls_list
  feat_file            = null           // REQUIRED(훈련) — pickled feature_dict
  mutations_file       = null           // 선택: PASS만 사용, 1kb 라벨 생성
  all_pred             = null           // pipeline_only 모드에서 필요
  out_dir              = 'results/run'
  pipeline_out_dir     = null           // 없으면 out_dir/postproc 로 설정됨 (파이썬에서)

  // === 세그먼트 생성 ===
  segment_lengths      = [10, 50, 100]
  discard_leftover     = false
  overlap_factor       = 0.3

  // === 학습 하이퍼파라미터 ===
  lr                   = 1e-4
  batch_size           = 128
  epochs               = 20
  seed                 = 42
  d_model              = 768
  nhead                = 8
  num_layers           = 6
  dim_feedforward      = 3072
  dropout              = 0.20
  max_seq_len          = 4096

  // === 학습 동작 옵션 ===
  label_roll           = true
  label_roll_width     = 2              // W>1이면 lam,y,len 동일창 롤링
  save_attention       = false
  cutmix_p             = 0.20
  num_data_workers     = 4
  torch_threads        = 8              // intra-op threads
  resume_checkpoint    = null           // 경로 주면 이어서 학습
  save_each_best       = false          // Val 개선 때마다 체크포인트 개별 저장

  // === 러닝레이트 스케줄 ===
  lr_sched_T0          = 50
  lr_sched_Tmult       = 1

  // === 얼리 스탑/개선 판단 ===
  early_stop           = true
  patience             = 5
  min_delta_pct        = 0.5

  // === 로버스트 캘리브레이션/샘플러 ===
  use_mad              = true
  huber_factor         = 3.0
  len_alpha            = 0.5
  res_beta             = 0.5

  // === 파이프라인(LLR → GMM → DP) ===
  pipeline_chunk_size    = 1_000_000
  pipeline_chunk_overlap = 100_000
  pipeline_min_distance  = 0
  pipeline_max_distance  = 100_000
  pipeline_sample_frac   = 0.01
  pipeline_gmm_k         = 2
  pipeline_gmm_auto      = true
  pipeline_beta          = 1.0
  pipeline_gamma         = 0.0
  pipeline_dp_gap_bp     = 0
  pipeline_seed          = null
  pipeline_presmooth_bins = 2          // 프리-스무딩 창(라벨 롤링 폭과 맞출 때 2 권장)

  // === Post-selection (Storey/BH 등) ===
  postsel_gmm_k_auto     = true
  postsel_gmm_k          = 2
  postsel_gmm_k_max      = 6
  postsel_gmm_n_init     = 10
  postsel_gmm_max_iter   = 500
  postsel_fdr_method     = 'storey'    // 'storey' or 'bh'
  postsel_bootstrap      = 400
  postsel_lambda_start   = 0.20
  postsel_lambda_end     = 0.95
  postsel_lambda_step    = 0.01
  postsel_pi0_floor      = 0.01
  postsel_pi0_ceil       = 1.00

  // === (옵션) GitHub Release 파츠 사용 ===
  use_release        = false
  gh_repo            = null            // 예: "silverflower10/DriverFormer"
  release_tag        = null
  asset_name         = 'parts'
  asset_sha256       = null
  gh_token           = null
}

// 파생 경로
params.post_dir = "${params.out_dir}/postproc"

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 환경 변수(태스크 내 공통)
 * --------------------------- */
env {
  MPLBACKEND = 'Agg'
  TOKENIZERS_PARALLELISM = 'false'
}

/* ---------------------------
 * 프로세스 공통 기본 리소스
 * --------------------------- */
process {
  cpus   = 16
  memory = '64 GB'
  time   = '24h'
}

/* ---------------------------
 * 프로파일 (CloudOS/AWS Batch GPU + 로컬)
 * --------------------------- */
profiles {
  awsbatch_gpu {
    process {
      executor      = 'awsbatch'
      container     = 'pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime'
      errorStrategy = 'retry'
      maxRetries    = 2
      accelerator   = 1              // GPU 1개
    }
    docker {
      enabled    = true
      runOptions = '--shm-size=32g'
    }
    singularity.enabled = false
    wave.enabled        = false
  }

  local {
    process {
      executor  = 'local'
      cpus      = 8
      memory    = '32 GB'
    }
    docker.enabled      = false
    singularity.enabled = false
    wave.enabled        = false
  }
}
