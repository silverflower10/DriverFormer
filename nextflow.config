// nextflow.config  — DriverFormer (DSL2)

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

params {
  // === pipeline 기본 ===
  pipeline_only      = false
  mutations_file     = null     // training 모드에서는 필수
  all_pred           = null     // pipeline-only 모드에서는 필수

  out_dir            = 'results/run'
  post_dir           = "${out_dir}/postproc"

  // === 학습 하이퍼파라미터(필요시 UI에서 덮어쓰기) ===
  lr                 = 2e-4
  batch_size         = 128
  epochs             = 20
  segment_lengths    = [10,50,100]
  label_roll         = true
  label_roll_width   = 2
  save_attention     = false

  // === 릴리즈(깃허브) 입력 옵션 ===
  use_release        = false
  gh_repo            = null                       // 예: "silverflower10/DriverFormer"
  release_tag        = null                       // 예: "breast-data-v1" or "breast-data-v2"
  asset_name         = "parts"                    // "parts" 또는 "breast_data.tar.gz"
  asset_sha256       = null                       // tar.gz 쓸 때만 선택
  gh_token           = null                       // 비공개 릴리즈면 필요
}

/* 공통 인스트루먼테이션(로그/리포트) */
profiles {

  local {
    process.executor = 'local'
    docker.enabled   = false
    singularity.enabled = false

    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  slurm {
    process.executor = 'slurm'

    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  /*
   * AWS Batch (GitHub Release의 분할 파트 사용)
   * - Tower에서 이 프로필을 선택
   * - 필요한 파라미터: use_release=true, gh_repo, release_tag, asset_name=parts, (private면 gh_token)
   */
  awsbatch_release_parts {
    process {
      executor  = 'awsbatch'
      container = 'public.ecr.aws/docker/library/python:3.11-bullseye' // bash + python 포함
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    wave.enabled = true  // 이미지 캐시/프록시
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }

  /*
   * AWS Batch (GitHub Release의 tar.gz 에셋 사용)
   */
  awsbatch_release_tar {
    process {
      executor  = 'awsbatch'
      container = 'public.ecr.aws/docker/library/python:3.11-bullseye'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    wave.enabled = true
    trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
    timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
    report   { enabled = true; file = "${params.out_dir}/report.html" }
    dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }
  }
}
