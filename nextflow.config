// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch 최소)
nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* ---------------------------
 * 파라미터 기본값
 * --------------------------- */
params {
  pipeline_only    = false
  mutations_file   = null
  all_pred         = null

  out_dir          = 'results/run'
  // post_dir은 아래에서 params.out_dir을 참조해 파생값으로 설정합니다.

  // 학습 관련
  lr               = 2e-4
  batch_size       = 128
  epochs           = 20
  segment_lengths  = [10, 50, 100]
  label_roll       = true
  label_roll_width = 2
  save_attention   = false

  // (옵션) GitHub Release 분할 파츠 사용 시
  use_release      = false
  gh_repo          = null
  release_tag      = null
  asset_name       = 'parts'
  asset_sha256     = null
  gh_token         = null
}
// 파생 파라미터 (다른 params 참조는 블록 밖이 안전)
params.post_dir = "${params.out_dir}/postproc"

/* ---------------------------
 * 공통 리포트/타임라인/DAG
 * --------------------------- */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* ---------------------------
 * 프로세스 공통 기본 리소스
 * --------------------------- */
process {
  cpus   = 4
  memory = '16 GB'
  time   = '24h'

  // DRIVERFORMER_RUN 또는 TRAIN_DRIVERFORMER 라는 이름의 프로세스를 위한 특별 설정
  withName: 'DRIVERFORMER_RUN|TRAIN_DRIVERFORMER' {
    label  'gpu'      // 'gpu' 라벨을 붙여줍니다.
    cpus   = 16       // GPU 인스턴스에 맞게 CPU 요청량 증가
    memory = '128 GB' // GPU 인스턴스에 맞게 메모리 요청량 증가
    time   = '72h'
  }
  // --- ⬆️ 여기까지 추가 ⬆️ ---
}


/* ---------------------------
 * 프로파일 (CloudOS 최소)
 * --------------------------- */
profiles {
  awsbatch_gpu {
    process {
      executor       = 'awsbatch'
      queue          = 'run_DriverFormer'                // CloudOS 큐 이름
      container      = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy  = 'retry'
      maxRetries     = 2
    }
    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = false   // Wave 403 회피
  }
}
