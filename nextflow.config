// nextflow.config — CloudOS/AWS Batch + Docker digest pin (DSL2, profile-agnostic)

manifest {
  name            = 'DriverFormer_cloudos'
  nextflowVersion = '!>=24.04.0'   // v24.04.4 권장, DSL2 전용
}

/* ── 컨테이너 참조 (다이제스트 고정) ───────────────────────────────────── */
params.container         = params.container         ?: null
params.container_repo    = params.container_repo    ?: 'docker.io/silverflower10/driverformer'
params.container_tag     = params.container_tag     ?: null
params.container_digest  = params.container_digest  ?: 'sha256:ac15ea10f138b6f03552e0c59d804fac2903392623a5cfb92b6d7340564237c8'

def _container_ref = params.container ?:
                     (params.container_digest ? "${params.container_repo}@${params.container_digest}"
                                              : (params.container_tag ? "${params.container_repo}:${params.container_tag}" : null))

if( _container_ref == null )
  throw new IllegalArgumentException(
    "Set container via one of: --container, or (--container_repo & --container_digest), or (--container_repo & --container_tag)")

/* ── 프로필과 무관하게 항상 적용될 전역 설정 ──────────────────────────── */
process {
  // 전역 기본 리소스
  cpus   = (params.cpus   ?: 8)
  memory = (params.memory ?: '64 GB')
  time   = (params.time   ?: '24h')

  // ★ 컨테이너는 전역으로 강제 (profile이 standard여도 적용)
  container = _container_ref

  // GPU 라벨 정책 (라벨 'gpu'가 붙으면 GPU 1개 요청)
  withLabel: gpu {
    accelerator 1
    cpus        (params.cpus   ?: 16)
    memory      (params.memory ?: '128 GB')
  }
}

/* ── 프로필(있으면 사용, 없어도 전역 설정으로 동작) ──────────────────── */
profiles {
  cloudos {
    process.executor    = 'awsbatch'
    docker.enabled      = true
    singularity.enabled = false
    // process.container는 이미 전역에서 지정했으므로 중복 지정 불필요
  }

  docker {
    process.executor    = 'local'
    docker.enabled      = true
    singularity.enabled = false
    docker.runOptions   = System.env.NF_GPU ? "--gpus ${System.env.NF_GPU}" : ''
    // 전역 container 사용
  }

  local {
    process.executor    = 'local'
    docker.enabled      = false
    conda.enabled       = false
  }
}
