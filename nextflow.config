// nextflow.config (repo root)

manifest {
  name        = 'DriverFormer_breast'
  mainScript  = 'main.nf'
  author      = 'silverflo'
  description = 'NHPP training + LLR→GMM→DP (local/release data sources)'
}

profiles {

  // ── 로컬 개발 기본 ──
  local {
    process.executor = 'local'
    params.out_dir   = 'results/run'
    params.post_dir  = 'results/run/postproc'
  }

  // ── SLURM 예시(환경 맞게 큐/옵션 수정 가능) ──
  slurm {
    process.executor     = 'slurm'
    process.queue        = 'debug'
    process.clusterOptions = '--account=pro'
    params.out_dir       = 'results/run'
    params.post_dir      = 'results/run/postproc'
  }

  // ── GitHub Release (분할 파트) 기본값 묶음 ──
  release_parts {
    params.use_release  = true
    params.gh_repo      = 'silverflower10/DriverFormer'
    params.release_tag  = 'breast-data-v1'
    params.asset_name   = 'parts'      // 분할 파트 모드
  }

  // ── GitHub Release (tar.gz) 기본값 묶음 ──
  release_tar {
    params.use_release  = true
    params.gh_repo      = 'silverflower10/DriverFormer'
    params.release_tag  = 'breast-data-v1'
    params.asset_name   = 'breast_data.tar.gz'
  }
}

profiles {

  // ---- AWS Batch 공통 실행 환경 ----
  awsbatch {
    process.executor   = 'awsbatch'
    // CloudOS/Tower에서 queue는 UI가 정할 수도 있지만, 필요시 명시:
    // process.queue    = 'your-aws-batch-queue'
    process.container  = 'continuumio/miniconda3:24.3.0-0'   // python+curl 포함
    process.shell      = ['/bin/bash','-lc']
  }

  // ---- AWS Batch + GitHub Release (분할 파트) ----
  awsbatch_release_parts {
    includeConfig 'profiles.awsbatch'
    params.use_release = true
    params.gh_repo     = 'silverflower10/DriverFormer'
    params.release_tag = 'breast-data-v1'      // ← v1로!
    params.asset_name  = 'parts'
  }
}

profiles {
  awsbatch {
    process.executor  = 'awsbatch'
    process.container = 'python:3.11'    // python만 있으면 충분 (curl/JQ 불필요)
    process.shell     = ['/bin/bash','-lc']
  }
  awsbatch_release_parts {
    includeConfig 'profiles.awsbatch'
    params.use_release = true
    params.gh_repo     = 'silverflower10/DriverFormer'
    params.release_tag = 'breast-data-v1'
    params.asset_name  = 'parts'
  }
}
