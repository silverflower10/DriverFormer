// nextflow.config — DriverFormer (DSL2, CloudOS/AWS Batch 안전 패치)
nextflow.enable.dsl = 2

manifest {
  name            = 'DriverFormer_breast'
  defaultBranch   = 'main'
  nextflowVersion = '!>=24.04.0'
}

/* 기본 파라미터 */
params {
  out_dir    = 'results/run'
}
params.post_dir = "${params.out_dir}/postproc"

/* 리포트 */
trace    { enabled = true; file = "${params.out_dir}/trace.txt" }
timeline { enabled = true; file = "${params.out_dir}/timeline.html" }
report   { enabled = true; file = "${params.out_dir}/report.html" }
dag      { enabled = true; file = "${params.out_dir}/flowchart.png" }

/* 프로세스 기본값 + 오버라이드 */
process {
  cpus   = 4
  memory = '16 GB'
  time   = '24h'

  env {
    PIP_NO_INPUT = '1'
    PIP_DISABLE_PIP_VERSION_CHECK = '1'
  }

  // === GPU 정책: 라벨 'gpu'에 GPU 1개
  withLabel: gpu {
    accelerator 1
    cpus   = 16
    memory = '128 GB'
    time   = '72h'
  }

  // 설치 단계(venv)
  withName: SETUP_DEPS {
    cpus   = 2
    memory = '8 GB'
    time   = '2h'
  }

  // 실행 단계 — 실제 프로세스명에 맞춰 둘 다 커버
  withName: DRIVERFORMER_RUN {
    label  'gpu'
    cpus   = 16
    memory = '128 GB'
    time   = '72h'
  }
  withName: TRAIN_DRIVERFORMER {
    label  'gpu'
    cpus   = 16
    memory = '128 GB'
    time   = '72h'
  }
}

/* 프로파일 */
profiles {
  awsbatch_gpu {
    process {
      executor      = 'awsbatch'                                   // Batch 강제
      // queue       = 'run_DriverFormer'                           // ← UI 큐 사용하려면 이 줄은 주석 유지
      // 운영 이미지(다이제스트 고정 권장) — 네가 쓴 PyTorch Hub 이미지 대신 아래 중 택1
      // container   = 'docker.io/silverflower10/driverformer@sha256:ac15ea10f138b6f03552e0c59d804fac2903392623a5cfb92b6d7340564237c8'
      container     = 'pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime'
      errorStrategy = 'retry'
      maxRetries    = 2
    }
    docker.enabled       = true
    singularity.enabled  = false
    wave.enabled         = false
  }
}
