// nextflow.config (repo root)

manifest {
  name       = 'DriverFormer_breast'
  mainScript = 'main.nf'
  author     = 'silverflo'
  description= 'NHPP training + LLR→GMM→DP (local / GitHub Release)'
}

profiles {

  local {
    process.executor = 'local'
    params.out_dir   = 'results/run'
    params.post_dir  = 'results/run/postproc'
  }

  slurm {
    process.executor     = 'slurm'
    process.queue        = 'debug'
    process.clusterOptions = '--account=pro'
    params.out_dir       = 'results/run'
    params.post_dir      = 'results/run/postproc'
  }

  // ---- AWS Batch 공통: Fusion v2 활성화 ----
  awsbatch {
    process.executor  = 'awsbatch'
    process.container = 'python:3.11'     // python만 필요 (다운로더는 python-only)
    process.shell     = ['/bin/bash','-lc']

    fusion {
      enabled = true
    }
  }

  // ---- AWS Batch + GitHub Release(분할 파트) ----
  awsbatch_release_parts {
    // 상속 대신 동일 설정을 명시 (includeConfig 사용 금지)
    process.executor  = 'awsbatch'
    process.container = 'python:3.11'
    process.shell     = ['/bin/bash','-lc']
    fusion.enabled    = true

    params.use_release = true
    params.gh_repo     = 'silverflower10/DriverFormer'
    params.release_tag = 'breast-data-v1'     // ← 반드시 v1 로!
    params.asset_name  = 'parts'
  }

  // (옵션) GitHub Release tar.gz 조합
  release_parts {
    params.use_release = true
    params.gh_repo     = 'silverflower10/DriverFormer'
    params.release_tag = 'breast-data-v1'
    params.asset_name  = 'parts'
  }
  release_tar {
    params.use_release = true
    params.gh_repo     = 'silverflower10/DriverFormer'
    params.release_tag = 'breast-data-v1'
    params.asset_name  = 'breast_data.tar.gz'
  }
}
